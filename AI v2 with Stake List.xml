xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="balance_start">balance_start</variable>
    <variable id="stake">stake</variable>
    <variable id="window_size">window_size</variable>
    <variable id="z_threshold">z_threshold</variable>
    <variable id="learning_rate">learning_rate</variable>
    <variable id="p_odd">p_odd</variable>
    <variable id="cooldown_ticks">cooldown_ticks</variable>
    <variable id="last_trade_tick">last_trade_tick</variable>
    <variable id="max_trades">max_trades</variable>
    <variable id="trade_count">trade_count</variable>
    <variable id="consec_losses">consec_losses</variable>
    <variable id="daily_loss_limit">daily_loss_limit</variable>
    <variable id="net_loss">net_loss</variable>
    <variable id="odd_count">odd_count</variable>
    <variable id="odd_rate">odd_rate</variable>
    <variable id="var">var</variable>
    <variable id="z">z</variable>
    <variable id="current_tick">current_tick</variable>
    <variable id="signal">signal</variable>
    <variable id="last_digit">last_digit</variable>
    <variable id="digit_buffer">digit_buffer</variable>
  </variables>

  <!-- INITIALIZATION -->
  <block type="trade_definition" id="trade_def" x="20" y="20">
    <field name="MARKET_LIST">volatility_indices</field>
    <field name="SUBMARKET_LIST">none</field>
    <field name="SYMBOL_LIST">R_10</field>
  </block>

  <block type="trade_parameters" id="trade_params" x="20" y="120">
    <field name="TRADETYPE_CATEGORY">digits</field>
    <field name="TRADETYPE">digitoddoreven</field>
    <field name="CANDLEINTERVAL">1</field>
    <field name="DURATION">1</field>
    <field name="DURATIONUNIT">t</field>
    <value name="AMOUNT">
      <block type="math_number">
        <field name="NUM">1</field>
      </block>
    </value>
  </block>

  <block type="logic_procedure" id="init_block" x="20" y="220">
    <mutation name="Initialize session"/>
    <statement name="STACK">
      <block type="variables_set">
        <field name="VAR">balance_start</field>
        <value name="VALUE">
          <block type="get_balance"/>
        </value>
        <next>
          <block type="variables_set">
            <field name="VAR">stake</field>
            <value name="VALUE"><block type="math_number"><field name="NUM">1</field></block></value>
            <next>
              <block type="variables_set">
                <field name="VAR">window_size</field>
                <value name="VALUE"><block type="math_number"><field name="NUM">20</field></block></value>
                <next>
                  <block type="variables_set">
                    <field name="VAR">z_threshold</field>
                    <value name="VALUE"><block type="math_number"><field name="NUM">1.4</field></block></value>
                    <next>
                      <block type="variables_set">
                        <field name="VAR">learning_rate</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">0.05</field></block></value>
                        <next>
                          <block type="variables_set">
                            <field name="VAR">p_odd</field>
                            <value name="VALUE"><block type="math_number"><field name="NUM">0.5</field></block></value>
                            <next>
                              <block type="variables_set">
                                <field name="VAR">cooldown_ticks</field>
                                <value name="VALUE"><block type="math_number"><field name="NUM">5</field></block></value>
                                <next>
                                  <block type="variables_set">
                                    <field name="VAR">last_trade_tick</field>
                                    <value name="VALUE"><block type="math_number"><field name="NUM">-1</field></block></value>
                                    <next>
                                      <block type="variables_set">
                                        <field name="VAR">max_trades</field>
                                        <value name="VALUE"><block type="math_number"><field name="NUM">2</field></block></value>
                                        <next>
                                          <block type="variables_set">
                                            <field name="VAR">trade_count</field>
                                            <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                                            <next>
                                              <block type="variables_set">
                                                <field name="VAR">consec_losses</field>
                                                <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                                                <next>
                                                  <block type="variables_set">
                                                    <field name="VAR">daily_loss_limit</field>
                                                    <value name="VALUE"><block type="math_number"><field name="NUM">10</field></block></value>
                                                    <next>
                                                      <block type="lists_create_with">
                                                        <mutation items="0"/>
                                                        <field name="VAR">digit_buffer</field>
                                                      </block>
                                                    </next>
                                                  </block>
                                                </next>
                                              </block>
                                            </next>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
  </block>

  <!-- MAIN LOOP: BEFORE PURCHASE -->
  <block type="before_purchase" id="before_purchase_block" x="20" y="520">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="get_last_digit">
        <field name="VAR">last_digit</field>
        <value name="VALUE">
          <block type="read_ohlc">
            <field name="OHLCFIELD">last_digit</field>
          </block>
        </value>
        <next>
          <!-- Push last_digit to buffer -->
          <block type="lists_setIndex">
            <mutation at="false" where="INSERT"/>
            <field name="MODE">INSERT</field>
            <field name="WHERE">END</field>
            <value name="LIST"><block type="variables_get"><field name="VAR">digit_buffer</field></block></value>
            <value name="TO"><block type="variables_get"><field name="VAR">last_digit</field></block></value>
            <next>
              <!-- If buffer longer than window_size, pop front -->
              <block type="controls_if">
                <value name="IF0">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A"><block type="lists_length"><value name="VALUE"><block type="variables_get"><field name="VAR">digit_buffer</field></block></value></block></value>
                    <value name="B"><block type="variables_get"><field name="VAR">window_size</field></block></value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="lists_getIndex">
                    <mutation at="true"/>
                    <field name="MODE">REMOVE</field>
                    <field name="WHERE">FIRST</field>
                    <value name="LIST"><block type="variables_get"><field name="VAR">digit_buffer</field></block></value>
                  </block>
                </statement>
                <next>
                  <!-- Compute odd_count -->
                  <block type="variables_set">
                    <field name="VAR">odd_count</field>
                    <value name="VALUE">
                      <block type="math_number">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="controls_forEach">
                        <field name="VAR">d</field>
                        <value name="LIST"><block type="variables_get"><field name="VAR">digit_buffer</field></block></value>
                        <statement name="DO">
                          <block type="controls_if">
                            <value name="IF0">
                              <block type="logic_compare">
                                <field name="OP">EQ</field>
                                <value name="A">
                                  <block type="math_modulo">
                                    <value name="DIVIDEND"><block type="variables_get"><field name="VAR">d</field></block></value>
                                    <value name="DIVISOR"><block type="math_number"><field name="NUM">2</field></block></value>
                                  </block>
                                </value>
                                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                              </block>
                            </value>
                            <statement name="DO0">
                              <block type="variables_set">
                                <field name="VAR">odd_count</field>
                                <value name="VALUE">
                                  <block type="math_arithmetic">
                                    <field name="OP">ADD</field>
                                    <value name="A"><block type="variables_get"><field name="VAR">odd_count</field></block></value>
                                    <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                                  </block>
                                </value>
                              </block>
                            </statement>
                          </block>
                        </statement>
                      </block>
                      <next>
                        <!-- odd_rate = odd_count / length(buffer) -->
                        <block type="variables_set">
                          <field name="VAR">odd_rate</field>
                          <value name="VALUE">
                            <block type="math_arithmetic">
                              <field name="OP">DIVIDE</field>
                              <value name="A"><block type="variables_get"><field name="VAR">odd_count</field></block></value>
                              <value name="B">
                                <block type="lists_length">
                                  <value name="VALUE"><block type="variables_get"><field name="VAR">digit_buffer</field></block></value>
                                </block>
                              </value>
                            </block>
                          </value>
                          <next>
                            <!-- var = 0.25 / length(buffer) -->
                            <block type="variables_set">
                              <field name="VAR">var</field>
                              <value name="VALUE">
                                <block type="math_arithmetic">
                                  <field name="OP">DIVIDE</field>
                                  <value name="A"><block type="math_number"><field name="NUM">0.25</field></block></value>
                                  <value name="B">
                                    <block type="lists_length">
                                      <value name="VALUE"><block type="variables_get"><field name="VAR">digit_buffer</field></block></value>
                                    </block>
                                  </value>
                                </block>
                              </value>
                              <next>
                                <!-- z = (odd_rate - 0.5)/sqrt(var) -->
                                <block type="variables_set">
                                  <field name="VAR">z</field>
                                  <value name="VALUE">
                                    <block type="math_arithmetic">
                                      <field name="OP">DIVIDE</field>
                                      <value name="A">
                                        <block type="math_arithmetic">
                                          <field name="OP">MINUS</field>
                                          <value name="A"><block type="variables_get"><field name="VAR">odd_rate</field></block></value>
                                          <value name="B"><block type="math_number"><field name="NUM">0.5</field></block></value>
                                        </block>
                                      </value>
                                      <value name="B">
                                        <block type="math_single">
                                          <field name="OP">ROOT</field>
                                          <value name="NUM"><block type="variables_get"><field name="VAR">var</field></block></value>
                                        </block>
                                      </value>
                                    </block>
                                  </value>
                                  <next>
                                    <!-- p_odd = p_odd + lr*(odd_rate - p_odd) -->
                                    <block type="variables_set">
                                      <field name="VAR">p_odd</field>
                                      <value name="VALUE">
                                        <block type="math_arithmetic">
                                          <field name="OP">ADD</field>
                                          <value name="A"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                          <value name="B">
                                            <block type="math_arithmetic">
                                              <field name="OP">MULTIPLY</field>
                                              <value name="A"><block type="variables_get"><field name="VAR">learning_rate</field></block></value>
                                              <value name="B">
                                                <block type="math_arithmetic">
                                                  <field name="OP">MINUS</field>
                                                  <value name="A"><block type="variables_get"><field name="VAR">odd_rate</field></block></value>
                                                  <value name="B"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                                </block>
                                              </value>
                                            </block>
                                          </value>
                                        </block>
                                      </value>
                                      <next>
                                        <!-- Risk gates -->
                                        <block type="variables_set">
                                          <field name="VAR">net_loss</field>
                                          <value name="VALUE">
                                            <block type="math_arithmetic">
                                              <field name="OP">MINUS</field>
                                              <value name="A"><block type="variables_get"><field name="VAR">balance_start</field></block></value>
                                              <value name="B"><block type="get_balance"/></value>
                                            </block>
                                          </value>
                                          <next>
                                            <block type="controls_if">
                                              <value name="IF0">
                                                <block type="logic_compare">
                                                  <field name="OP">GTE</field>
                                                  <value name="A"><block type="variables_get"><field name="VAR">net_loss</field></block></value>
                                                  <value name="B"><block type="variables_get"><field name="VAR">daily_loss_limit</field></block></value>
                                                </block>
                                              </value>
                                              <statement name="DO0">
                                                <block type="bot_notification">
                                                  <field name="NOTIF_TYPE">warning</field>
                                                  <value name="MESSAGE"><block type="text"><field name="TEXT">Daily loss limit reached. Stopping.</field></block></value>
                                                </block>
                                                <next><block type="bot_stop"/></next>
                                              </statement>
                                              <next>
                                                <block type="controls_if">
                                                  <value name="IF0">
                                                    <block type="logic_compare">
                                                      <field name="OP">GTE</field>
                                                      <value name="A"><block type="variables_get"><field name="VAR">consec_losses</field></block></value>
                                                      <value name="B"><block type="math_number"><field name="NUM">4</field></block></value>
                                                    </block>
                                                  </value>
                                                  <statement name="DO0">
                                                    <block type="bot_notification">
                                                      <field name="NOTIF_TYPE">warning</field>
                                                      <value name="MESSAGE"><block type="text"><field name="TEXT">Max consecutive losses reached. Stopping.</field></block></value>
                                                    </block>
                                                    <next><block type="bot_stop"/></next>
                                                  </statement>
                                                  <next>
                                                    <block type="controls_if">
                                                      <value name="IF0">
                                                        <block type="logic_compare">
                                                          <field name="OP">GTE</field>
                                                          <value name="A"><block type="variables_get"><field name="VAR">trade_count</field></block></value>
                                                          <value name="B"><block type="variables_get"><field name="VAR">max_trades</field></block></value>
                                                        </block>
                                                      </value>
                                                      <statement name="DO0">
                                                        <block type="bot_notification">
                                                          <field name="NOTIF_TYPE">info</field>
                                                          <value name="MESSAGE"><block type="text"><field name="TEXT">Session limit reached (2 trades). Stopping.</field></block></value>
                                                        </block>
                                                        <next><block type="bot_stop"/></next>
                                                      </statement>
                                                      <next>
                                                        <!-- Cooldown -->
                                                        <block type="variables_set">
                                                          <field name="VAR">current_tick</field>
                                                          <value name="VALUE"><block type="epoch"/></value>
                                                          <next>
                                                            <block type="controls_if">
                                                              <value name="IF0">
                                                                <block type="logic_compare">
                                                                  <field name="OP">LT</field>
                                                                  <value name="A">
                                                                    <block type="math_arithmetic">
                                                                      <field name="OP">MINUS</field>
                                                                      <value name="A"><block type="variables_get"><field name="VAR">current_tick</field></block></value>
                                                                      <value name="B"><block type="variables_get"><field name="VAR">last_trade_tick</field></block></value>
                                                                    </block>
                                                                  </value>
                                                                  <value name="B"><block type="variables_get"><field name="VAR">cooldown_ticks</field></block></value>
                                                                </block>
                                                              </value>
                                                              <statement name="DO0">
                                                                <block type="controls_flow_statements">
                                                                  <field name="FLOW">CONTINUE</field>
                                                                </block>
                                                              </statement>
                                                              <next>
                                                                <!-- |z| >= threshold -->
                                                                <block type="controls_if">
                                                                  <value name="IF0">
                                                                    <block type="logic_compare">
                                                                      <field name="OP">GTE</field>
                                                                      <value name="A">
                                                                        <block type="math_single">
                                                                          <field name="OP">ABS</field>
                                                                          <value name="NUM"><block type="variables_get"><field name="VAR">z</field></block></value>
                                                                        </block>
                                                                      </value>
                                                                      <value name="B"><block type="variables_get"><field name="VAR">z_threshold</field></block></value>
                                                                    </block>
                                                                  </value>
                                                                  <statement name="DO0">
                                                                    <!-- Decide signal -->
                                                                    <block type="controls_if">
                                                                      <value name="IF0">
                                                                        <block type="logic_operation">
                                                                          <field name="OP">AND</field>
                                                                          <value name="A">
                                                                            <block type="logic_compare">
                                                                              <field name="OP">GT</field>
                                                                              <value name="A"><block type="variables_get"><field name="VAR">z</field></block></value>
                                                                              <value name="B"><block type="math_number"><field name="NUM">0</field></block></value>
                                                                            </block>
                                                                          </value>
                                                                          <value name="B">
                                                                            <block type="logic_compare">
                                                                              <field name="OP">GTE</field>
                                                                              <value name="A"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                                                              <value name="B"><block type="math_number"><field name="NUM">0.55</field></block></value>
                                                                            </block>
                                                                          </value>
                                                                        </block>
                                                                      </value>
                                                                      <statement name="DO0">
                                                                        <block type="variables_set">
                                                                          <field name="VAR">signal</field>
                                                                          <value name="VALUE"><block type="text"><field name="TEXT">ODD</field></block></value>
                                                                        </block>
                                                                      </statement>
                                                                      <value name="IF1">
                                                                        <block type="logic_operation">
                                                                          <field name="OP">AND</field>
                                                                          <value name="A">
                                                                            <block type="logic_compare">
                                                                              <field name="OP">LT</field>
                                                                              <value name="A"><block type="variables_get"><field name="VAR">z</field></block></value>
                                                                              <value name="B"><block type="math_number"><field name="NUM">0</field></block></value>
                                                                            </block>
                                                                          </value>
                                                                          <value name="B">
                                                                            <block type="logic_compare">
                                                                              <field name="OP">GTE</field>
                                                                              <value name="A">
                                                                                <block type="math_arithmetic">
                                                                                  <field name="OP">MINUS</field>
                                                                                  <value name="A"><block type="math_number"><field name="NUM">1</field></block></value>
                                                                                  <value name="B"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                                                                </block>
                                                                              </value>
                                                                              <value name="B"><block type="math_number"><field name="NUM">0.55</field></block></value>
                                                                            </block>
                                                                          </value>
                                                                        </block>
                                                                      </value>
                                                                      <statement name="DO1">
                                                                        <block type="variables_set">
                                                                          <field name="VAR">signal</field>
                                                                          <value name="VALUE"><block type="text"><field name="TEXT">EVEN</field></block></value>
                                                                        </block>
                                                                      </statement>
                                                                      <next>
                                                                        <!-- If signal not set, continue -->
                                                                        <block type="controls_if">
                                                                          <value name="IF0">
                                                                            <block type="logic_compare">
                                                                              <field name="OP">EQ</field>
                                                                              <value name="A"><block type="variables_get"><field name="VAR">signal</field></block></value>
                                                                              <value name="B"><block type="text"><field name="TEXT"></field></block></value>
                                                                            </block>
                                                                          </value>
                                                                          <statement name="DO0">
                                                                            <block type="controls_flow_statements">
                                                                              <field name="FLOW">CONTINUE</field>
                                                                            </block>
                                                                          </statement>
                                                                        </block>
                                                                      </next>
                                                                    </block>
                                                                  </statement>
                                                                </block>
                                                              </next>
                                                            </block>
                                                          </next>
                                                        </block>
                                                      </next>
                                                    </block>
                                                  </next>
                                                </block>
                                              </next>
                                            </block>
                                          </next>
                                        </block>
                                      </next>
                                    </block>
                                  </next>
                                </block>
                              </next>
                            </block>
                          </next>
                        </block>
                      </next>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- PURCHASE -->
  <block type="purchase" id="purchase_block" x="20" y="1180">
    <value name="CONTRACT_TYPE">
      <block type="text">
        <field name="TEXT">DIGIT ODD/EVEN</field>
      </block>
    </value>
    <value name="PREDICTION">
      <block type="variables_get">
        <field name="VAR">signal</field>
      </block>
    </value>
    <next>
      <block type="after_purchase" id="after_purchase_block">
        <statement name="AFTERPURCHASE_STACK">
          <!-- Update last_trade_tick and trade_count -->
          <block type="variables_set">
            <field name="VAR">last_trade_tick</field>
            <value name="VALUE"><block type="epoch"/></value>
            <next>
              <block type="variables_set">
                <field name="VAR">trade_count</field>
                <value name="VALUE">
                  <block type="math_arithmetic">
                    <field name="OP">ADD</field>
                    <value name="A"><block type="variables_get"><field name="VAR">trade_count</field></block></value>
                    <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                  </block>
                </value>
                <next>
                  <!-- Win/Loss handling -->
                  <block type="controls_if">
                    <value name="IF0">
                      <block type="check_result">
                        <field name="CHECKRESULT">win</field>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="variables_set">
                        <field name="VAR">consec_losses</field>
                        <value name="VALUE"><block type="math_number"><field name="NUM">0</field></block></value>
                        <next>
                          <!-- p_odd = p_odd + lr*(1 - p_odd) -->
                          <block type="variables_set">
                            <field name="VAR">p_odd</field>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                <value name="B">
                                  <block type="math_arithmetic">
                                    <field name="OP">MULTIPLY</field>
                                    <value name="A"><block type="variables_get"><field name="VAR">learning_rate</field></block></value>
                                    <value name="B">
                                      <block type="math_arithmetic">
                                        <field name="OP">MINUS</field>
                                        <value name="A"><block type="math_number"><field name="NUM">1</field></block></value>
                                        <value name="B"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </next>
                      </block>
                    </statement>
                    <next>
                      <block type="controls_if">
                        <value name="IF0">
                          <block type="check_result">
                            <field name="CHECKRESULT">loss</field>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="variables_set">
                            <field name="VAR">consec_losses</field>
                            <value name="VALUE">
                              <block type="math_arithmetic">
                                <field name="OP">ADD</field>
                                <value name="A"><block type="variables_get"><field name="VAR">consec_losses</field></block></value>
                                <value name="B"><block type="math_number"><field name="NUM">1</field></block></value>
                              </block>
                            </value>
                            <next>
                              <!-- p_odd = p_odd - lr*p_odd -->
                              <block type="variables_set">
                                <field name="VAR">p_odd</field>
                                <value name="VALUE">
                                  <block type="math_arithmetic">
                                    <field name="OP">MINUS</field>
                                    <value name="A"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                    <value name="B">
                                      <block type="math_arithmetic">
                                        <field name="OP">MULTIPLY</field>
                                        <value name="A"><block type="variables_get"><field name="VAR">learning_rate</field></block></value>
                                        <value name="B"><block type="variables_get"><field name="VAR">p_odd</field></block></value>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                  <next>
                    <!-- Stop when trade_count = 2 -->
                    <block type="controls_if">
                      <value name="IF0">
                        <block type="logic_compare">
                          <field name="OP">EQ</field>
